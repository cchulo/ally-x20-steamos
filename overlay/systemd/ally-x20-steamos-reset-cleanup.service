# Factory-reset fail-safe. A SteamOS factory reset only leaves a marker on
# the ESP (efi/steamos/factory-reset/*.cfg) and wipes var, home and /etc at
# the next boot; the efi partitions are not wiped, and afterwards nothing of
# ours is left to restore them. So this unit does nothing while the system
# runs (ExecStart=/bin/true, RemainAfterExit) and, when it is stopped at
# shutdown/reboot with a reset pending, restores the stock grub.cfg and
# deletes the ACPI early initrd on both slots' efi partitions
# (uninstall/efi-cleanup.sh --all-slots). Without a pending reset the stop
# only mounts the ESP privately, finds no marker and returns.
#
# The partitions are mounted privately from /dev/disk/by-partsets instead of
# going through the /efi and /esp automounts: RequiresMountsFor=/efi would
# make an idle-timeout expiry of efi.mount stop this unit early, and an
# expired automount cannot be re-triggered once shutdown has begun. The
# ordering keeps the stop ahead of the automount units and of local-fs
# (the checkout under /var/lib/ally-x20-steamos, possibly on /home).
[Unit]
Description=ally-x20-steamos: restore stock EFI boot files before a pending factory reset
Documentation=file:///var/lib/ally-x20-steamos/src/docs/uninstall.md
After=local-fs.target efi.automount esp.automount
ConditionPathExists=/var/lib/ally-x20-steamos/src/uninstall/efi-cleanup.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=-/bin/sh /var/lib/ally-x20-steamos/src/uninstall/efi-cleanup.sh --if-reset-pending --all-slots --keep
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
