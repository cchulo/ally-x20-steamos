# Component inputplumber (docs/inputplumber.md): after a suspend/resume cycle
# on the ROG Xbox Ally X20, re-send the controller's mode settings.
#
# After some resumes the sticks stay dead (issue #63): the controller's MCU
# loses gamepad_mode and qam_mode while the host sleeps, although it stays
# on the bus and the driver attributes still read the old values. Units
# wanted by suspend.target and ordered after it start once
# systemd-suspend.service has returned, that is after the resume. The helper
# writes both attributes back with their current values (1 s after the
# resume and once more 3 s later); InputPlumber keeps running, so Steam does
# not see the controller drop. Without the attributes it falls back to
# `systemctl try-restart inputplumber.service`.
# ally-x20-steamos-xbox-led-resume.service is ordered after this unit so the
# Xbox-button light settings are sent once the controller is settled.
[Unit]
Description=ally-x20-steamos: re-send the controller settings after resume
Documentation=file:///var/lib/ally-x20-steamos/src/docs/inputplumber.md
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
ConditionPathExists=/etc/inputplumber/devices.d/50-rog_xbox_ally_x20.yaml
ConditionPathExists=/etc/ally-x20-steamos/inputplumber-resume-check

[Service]
Type=oneshot
ExecStart=/etc/ally-x20-steamos/inputplumber-resume-check
TimeoutStartSec=60s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
