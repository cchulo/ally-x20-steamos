#!/usr/bin/env bats
# SPDX-License-Identifier: GPL-2.0-only
# uninstall/efi-cleanup.sh: the EFI fail-safe copied next to the stage-2
# grub.cfg. Every behaviour is checked under dash and bash.
load '../test_helper'
load '../update_helper'

CLEANUP="$REPO_ROOT/uninstall/efi-cleanup.sh"
SHELLS="dash bash"

setup() {
    make_root >/dev/null
    source_libs
    # shellcheck disable=SC1091
    . "$REPO_ROOT/lib/slots.sh"
    unset AX20_SLOT AX20_BOOT_ENTRY
    D="$AX20_ROOT/efi/EFI/steamos"
    PRISTINE="$BATS_TEST_TMPDIR/pristine"
    MODIFIED="$BATS_TEST_TMPDIR/modified"
    IMG_BYTES="$BATS_TEST_TMPDIR/acpi.img"
    # Not installed here (the "still installed" warning has its own test).
    AX20_CLEANUP_STATE="$BATS_TEST_TMPDIR/no-state"
    export AX20_CLEANUP_STATE
    # A grub.cfg modified by lib/slots.sh exactly as apply does it.
    fixture_grub
    [ -z "${NOEOL:-}" ] || printf '%s' "$(cat "$D/grub.cfg")" >"$D/grub.cfg"
    cp "$D/grub.cfg" "$PRISTINE"
    fixture_initrd
    cp "$D/ally-x20-steamos-acpi.img" "$IMG_BYTES"
    slots_entry_apply A "firmware_class.path=/etc/ally-x20-steamos/firmware" \
        /efi/EFI/steamos/ally-x20-steamos-acpi.img 2>/dev/null
    cp "$D/grub.cfg" "$MODIFIED"
}

# efi_dir [dir] : reset <dir> (default $D) to the installed state: marked
# grub.cfg, early initrd and the clean-up script next to them.
efi_dir() {
    local d=${1:-$D}
    rm -rf "$d"
    mkdir -p "$d"
    cp "$MODIFIED" "$d/grub.cfg"
    cp "$IMG_BYTES" "$d/ally-x20-steamos-acpi.img"
    cp "$CLEANUP" "$d/ally-x20-steamos-cleanup.sh"
}

@test "a marked grub.cfg is regenerated byte-identical, the image and the script are removed" {
    for sh in $SHELLS; do
        efi_dir
        grep -q '^# ally-x20-steamos-args:' "$D/grub.cfg"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh"
        assert_success
        assert_output_contains "matches the recorded original digest"
        assert_output_contains "ally-x20-steamos-cleanup: $D: boot entry restored (matches the recorded original digest), early initrd removed, clean-up script removed"
        cmp "$D/grub.cfg" "$PRISTINE"
        [ ! -e "$D/ally-x20-steamos-acpi.img" ]
        [ ! -e "$D/ally-x20-steamos-cleanup.sh" ]
        [ ! -e "$D/grub.cfg.ally-x20-steamos.tmp" ]
        # Nothing else left behind in the directory.
        [ "$(ls "$D")" = grub.cfg ]
    done
}

@test "an entry without a final newline is regenerated byte-identical" {
    NOEOL=1 setup
    for sh in $SHELLS; do
        efi_dir
        run "$sh" "$D/ally-x20-steamos-cleanup.sh"
        assert_success
        cmp "$D/grub.cfg" "$PRISTINE"
    done
}

@test "a digest mismatch is reported and the stripped entry is still written" {
    for sh in $SHELLS; do
        efi_dir
        sed 's/rd.luks=0/rd.luks=1/' "$MODIFIED" >"$D/grub.cfg"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh"
        assert_success
        assert_output_contains "differs from the recorded original digest"
        assert_output_contains "wrote the stripped version anyway"
        ! grep -q 'ally-x20-steamos' "$D/grub.cfg"
        [ "$(cat "$D/grub.cfg")" = "$(sed 's/rd.luks=0/rd.luks=1/' "$PRISTINE")" ]
        [ ! -e "$D/ally-x20-steamos-acpi.img" ]
    done
}

@test "the image is deleted only when no remaining entry in the directory references it" {
    for sh in $SHELLS; do
        # Another cfg still loads it: kept, exit 1, grub.cfg still restored.
        efi_dir
        printf 'initrd ${cmdpath}/ally-x20-steamos-acpi.img\n' >"$D/custom.cfg"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_failure 1
        assert_output_contains "keeping $D/ally-x20-steamos-acpi.img: custom.cfg still references it"
        cmp "$D/grub.cfg" "$PRISTINE"
        [ -f "$D/ally-x20-steamos-acpi.img" ]
        # A leftover image next to a stock grub.cfg: removed.
        rm -f "$D/custom.cfg"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_success
        assert_output_contains "$D: early initrd removed"
        [ ! -e "$D/ally-x20-steamos-acpi.img" ]
        cmp "$D/grub.cfg" "$PRISTINE"
    done
}

@test "--keep keeps the script; without it the script deletes itself" {
    for sh in $SHELLS; do
        efi_dir
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_success
        [ -f "$D/ally-x20-steamos-cleanup.sh" ]
        cmp "$D/ally-x20-steamos-cleanup.sh" "$CLEANUP"
        # Second run: nothing left but the script itself.
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_success
        assert_output_contains "$D: nothing to do"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh"
        assert_success
        assert_output_contains "$D: clean-up script removed"
        [ ! -e "$D/ally-x20-steamos-cleanup.sh" ]
    done
}

@test "--dry-run prints every action and changes nothing" {
    for sh in $SHELLS; do
        efi_dir
        before=$(tree_digest "$AX20_ROOT/efi")
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --dry-run
        assert_success
        assert_output_contains "[dry-run] regenerate $D/grub.cfg from the ally-x20-steamos marker (matches the recorded original digest)"
        assert_output_contains "[dry-run] rm $D/ally-x20-steamos-acpi.img"
        assert_output_contains "[dry-run] rm $D/ally-x20-steamos-cleanup.sh"
        [ "$(tree_digest "$AX20_ROOT/efi")" = "$before" ]
    done
}

@test "files without our marker are never touched" {
    for sh in $SHELLS; do
        rm -rf "$D"
        mkdir -p "$D"
        cp "$PRISTINE" "$D/grub.cfg"
        printf '# ally-x20-steamos mentioned in a comment, but no marker\n' >>"$D/grub.cfg"
        cp "$D/grub.cfg" "$BATS_TEST_TMPDIR/stock"
        printf 'other\n' >"$D/grubx64.efi"
        cp "$CLEANUP" "$D/ally-x20-steamos-cleanup.sh"
        before=$(tree_digest "$AX20_ROOT/efi")
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_success
        assert_output_contains "ally-x20-steamos-cleanup: $D: nothing to do"
        [ "$(tree_digest "$AX20_ROOT/efi")" = "$before" ]
        # A symlinked grub.cfg is not followed even when its target is marked.
        rm -f "$D/grub.cfg"
        cp "$MODIFIED" "$BATS_TEST_TMPDIR/target.cfg"
        ln -s "$BATS_TEST_TMPDIR/target.cfg" "$D/grub.cfg"
        run "$sh" "$D/ally-x20-steamos-cleanup.sh" --keep
        assert_success
        [ -L "$D/grub.cfg" ]
        cmp "$BATS_TEST_TMPDIR/target.cfg" "$MODIFIED"
    done
}

@test "a directory argument cleans that directory only; the running file is not deleted" {
    for sh in $SHELLS; do
        efi_dir
        efi_dir "$BATS_TEST_TMPDIR/elsewhere"
        run "$sh" "$CLEANUP" "$D"
        assert_success
        cmp "$D/grub.cfg" "$PRISTINE"
        [ ! -e "$D/ally-x20-steamos-acpi.img" ]
        [ ! -e "$D/ally-x20-steamos-cleanup.sh" ]
        [ -f "$CLEANUP" ]
        cmp "$BATS_TEST_TMPDIR/elsewhere/grub.cfg" "$MODIFIED"
        [ -f "$BATS_TEST_TMPDIR/elsewhere/ally-x20-steamos-acpi.img" ]
        # Without an argument it works on its own directory (here: the
        # checkout's uninstall/, where there is nothing to do).
        run "$sh" "$CLEANUP" --keep
        assert_success
        assert_output_contains "$REPO_ROOT/uninstall: nothing to do"
    done
}

@test "usage: -h, unknown options, missing or conflicting directories" {
    for sh in $SHELLS; do
        run "$sh" "$CLEANUP" -h
        assert_success
        assert_output_contains "Usage: sh ally-x20-steamos-cleanup.sh"
        run "$sh" "$CLEANUP" --bogus
        assert_failure 2
        run "$sh" "$CLEANUP" "$BATS_TEST_TMPDIR/missing"
        assert_failure 2
        run "$sh" "$CLEANUP" --all-slots "$D"
        assert_failure 2
        run "$sh" "$CLEANUP" "$D" "$D"
        assert_failure 2
    done
}

@test "an installed system gets a warning that the boot service will re-apply" {
    efi_dir
    mkdir -p "$BATS_TEST_TMPDIR/state"
    : >"$BATS_TEST_TMPDIR/state/manifest"
    AX20_CLEANUP_STATE="$BATS_TEST_TMPDIR/state" run sh "$D/ally-x20-steamos-cleanup.sh"
    assert_success
    assert_output_contains "still installed on this system"
    cmp "$D/grub.cfg" "$PRISTINE"
}

# ------------------------------------------------- --all-slots / reset --
# Fake mount/umount: a "device" is a by-partsets symlink to a fixture
# directory; mounting replaces the mount point with a symlink to it.
fake_partsets() {
    local p="$BATS_TEST_TMPDIR/partsets" b="$BATS_TEST_TMPDIR/bin"
    mkdir -p "$p/A" "$p/B" "$p/shared" "$b" "$BATS_TEST_TMPDIR/dev/esp"
    efi_dir "$BATS_TEST_TMPDIR/dev/efiA/EFI/steamos"
    efi_dir "$BATS_TEST_TMPDIR/dev/efiB/EFI/steamos"
    ln -sfn "$BATS_TEST_TMPDIR/dev/efiA" "$p/A/efi"
    ln -sfn "$BATS_TEST_TMPDIR/dev/efiB" "$p/B/efi"
    ln -sfn "$BATS_TEST_TMPDIR/dev/esp" "$p/shared/esp"
    cat >"$b/mount" <<'EOF'
#!/bin/sh
for a in "$@"; do dev=$mnt; mnt=$a; done
printf 'mount %s\n' "$mnt" >>"$FAKE_MOUNT_LOG"
rmdir "$mnt" && ln -s "$(cd "$dev" && pwd -P)" "$mnt"
EOF
    cat >"$b/umount" <<'EOF'
#!/bin/sh
printf 'umount %s\n' "$1" >>"$FAKE_MOUNT_LOG"
[ -L "$1" ] && rm "$1" && mkdir "$1"
EOF
    chmod +x "$b/mount" "$b/umount"
    PATH="$b:$PATH"
    AX20_CLEANUP_PARTSETS=$p
    AX20_CLEANUP_RUNDIR="$BATS_TEST_TMPDIR/run"
    AX20_CLEANUP_ESP="$BATS_TEST_TMPDIR/no-esp"
    FAKE_MOUNT_LOG="$BATS_TEST_TMPDIR/mounts.log"
    : >"$FAKE_MOUNT_LOG"
    export PATH AX20_CLEANUP_PARTSETS AX20_CLEANUP_RUNDIR AX20_CLEANUP_ESP FAKE_MOUNT_LOG
}

@test "--if-reset-pending without a pending reset only looks at the ESP" {
    for sh in $SHELLS; do
        fake_partsets
        before=$(tree_digest "$BATS_TEST_TMPDIR/dev")
        run "$sh" "$CLEANUP" --if-reset-pending --all-slots --keep
        assert_success
        assert_output_contains "no factory reset pending; nothing to do"
        [ "$(tree_digest "$BATS_TEST_TMPDIR/dev")" = "$before" ]
        [ "$(cat "$FAKE_MOUNT_LOG")" = "mount $BATS_TEST_TMPDIR/run/esp
umount $BATS_TEST_TMPDIR/run/esp" ]
        [ ! -e "$BATS_TEST_TMPDIR/run/esp" ]
    done
}

@test "--if-reset-pending --all-slots cleans both slots when a factory reset is pending" {
    for sh in $SHELLS; do
        fake_partsets
        mkdir -p "$BATS_TEST_TMPDIR/dev/esp/efi/steamos/factory-reset"
        printf 'x\n' >"$BATS_TEST_TMPDIR/dev/esp/efi/steamos/factory-reset/var.cfg"
        run "$sh" "$CLEANUP" --if-reset-pending --all-slots --keep
        assert_success
        assert_output_contains "slot A: boot entry restored (matches the recorded original digest), early initrd removed; slot B: boot entry restored"
        for s in A B; do
            cmp "$BATS_TEST_TMPDIR/dev/efi$s/EFI/steamos/grub.cfg" "$PRISTINE"
            [ ! -e "$BATS_TEST_TMPDIR/dev/efi$s/EFI/steamos/ally-x20-steamos-acpi.img" ]
            [ -f "$BATS_TEST_TMPDIR/dev/efi$s/EFI/steamos/ally-x20-steamos-cleanup.sh" ]
            [ ! -e "$BATS_TEST_TMPDIR/run/efi-$s" ]
        done
        # The marker itself is SteamOS's business.
        [ -f "$BATS_TEST_TMPDIR/dev/esp/efi/steamos/factory-reset/var.cfg" ]
        grep -qx "umount $BATS_TEST_TMPDIR/run/efi-B" "$FAKE_MOUNT_LOG"
    done
}

@test "--all-slots without --keep also removes each slot's copy of the script" {
    for sh in $SHELLS; do
        fake_partsets
        run "$sh" "$CLEANUP" --all-slots
        assert_success
        for s in A B; do
            [ ! -e "$BATS_TEST_TMPDIR/dev/efi$s/EFI/steamos/ally-x20-steamos-cleanup.sh" ]
        done
        [ -f "$CLEANUP" ]
    done
}

@test "--all-slots without partsets falls back to its own directory" {
    for sh in $SHELLS; do
        efi_dir
        AX20_CLEANUP_PARTSETS="$BATS_TEST_TMPDIR/none" run "$sh" "$D/ally-x20-steamos-cleanup.sh" --all-slots --keep
        assert_success
        assert_output_contains "cleaning $D only"
        cmp "$D/grub.cfg" "$PRISTINE"
    done
}
