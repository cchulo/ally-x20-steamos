# Component inputplumber (docs/inputplumber.md): after a suspend/resume cycle
# on the ROG Xbox Ally X20, restart InputPlumber when the gamepad did not
# come back.
#
# After some resumes the gamepad stops working until the daemon is restarted
# (issue #63; the sticks have been seen dead as well). Units wanted by
# suspend.target and ordered after it start once systemd-suspend.service has
# returned, that is after the resume. The helper waits up to 10 s for the
# gamepad to be connected (kernel input device present and held by
# InputPlumber) and runs `systemctl try-restart inputplumber.service` only
# when it is not; try-restart leaves a stopped or disabled daemon alone.
# ally-x20-steamos-xbox-led-resume.service is ordered after this unit so the
# Xbox-button light settings are sent once the daemon is settled.
[Unit]
Description=ally-x20-steamos: restart InputPlumber after resume if the gamepad is missing
Documentation=file:///var/lib/ally-x20-steamos/src/docs/inputplumber.md
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
ConditionPathExists=/etc/inputplumber/devices.d/50-rog_xbox_ally_x20.yaml
ConditionPathExists=/etc/ally-x20-steamos/inputplumber-resume-check

[Service]
Type=oneshot
ExecStart=/etc/ally-x20-steamos/inputplumber-resume-check
TimeoutStartSec=60s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
