(PR #2493, merged 2026-10-18)
Applied unmodified to gamescope 3.16.30.1 by ally-x20-steamos. The full
BSD-2-Clause text is in patches/gamescope/LICENSE.

 scripts/00-gamescope/displays/asus.rogallyx20.oled.lua | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/00-gamescope/displays/asus.rogallyx20.oled.lua b/scripts/00-gamescope/displays/asus.rogallyx20.oled.lua
index e9ee34d..286e426 100644
--- a/scripts/00-gamescope/displays/asus.rogallyx20.oled.lua
+++ b/scripts/00-gamescope/displays/asus.rogallyx20.oled.lua
@@ -18,6 +18,8 @@ gamescope.config.known_displays.rogallyx20_oled = {
         force_enabled = false,
         eotf = gamescope.eotf.pq,
         content_driven = true,
+        -- The panel ignores hardware backlight control while in PQ mode.
+        software_backlight = true,
         -- From the EDID's DisplayID 2 HDR block, which libdisplay-info before 0.4.0 cannot find.
         max_content_light_level = 1405,
         max_frame_average_luminance = 800,
