# Build outputs and binaries that must never be committed (see X20-STEAMOS-PLAN.md)
*.ko
*.ko.zst
*.o
*.so
*.so.[0-9]*
build/out/
build/cache/
*.img
*.qcow2
*.iso
# Firmware blobs are downloaded at install time, never committed
firmware/*.bin
# Tooling
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
tests/.tmp/
