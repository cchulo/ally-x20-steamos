# Component chargelimit (docs/power.md, "Battery charge limit"): write the
# battery charge limit in force again after a suspend/resume cycle (a 0
# becomes 100). Units wanted by a sleep target and ordered after it start
# once the system has resumed. TODO(hw): whether the embedded controller
# drops the limit across s2idle is not measured; the write is harmless when
# it does not.
[Unit]
Description=ally-x20-steamos: write the battery charge limit again after resume
Documentation=file:///var/lib/ally-x20-steamos/src/docs/power.md
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
ConditionPathExists=/etc/ally-x20-steamos/charge-limit-restore

[Service]
Type=oneshot
ExecStart=/etc/ally-x20-steamos/charge-limit-restore resume
TimeoutStartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
